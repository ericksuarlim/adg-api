# Copy to `compose.env` in this folder (gitignored) to override Docker Compose host ports.
# Docker Compose reads `compose.env` only if you use: docker compose --env-file compose.env up

ADG_DB_HOST_PORT=15433
ADG_API_PORT=3010
ADG_NODE_DEBUG_PORT=9230
ADG_UI_PORT=4730

ADG_DB_NAME=adg-db-postgres
ADG_DB_USER=adg-user-postgres
ADG_DB_PASSWORD=postgres
ADG_JWT_SECRET=local-super-secret-key
# Optional: max cached Sequelize connections per tenant DB per API process (passed as TENANT_POOL_MAX to api service if wired)
# ADG_TENANT_POOL_MAX=32
# Dev: set to true once so API adds new SaaS columns (user_ranches.uuid_company, etc.). Prefer running scripts/saas-tenant-rollout-ddl.sql in prod.
# ADG_DB_SYNC_ALTER=true
