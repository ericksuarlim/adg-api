# Local API (`npm run dev` / VS Code "API: Debug"). If PostgreSQL runs via
# `adg-api/docker-compose.yml`, use DB_PORT=15433 (host maps 15433 -> container 5432).
# If you use a local PostgreSQL on 5432 instead, set DB_PORT=5432.
#
# Docker Compose host ports and secrets for `docker compose up` in this folder:
# see `compose.env.example` (copy to `compose.env` and use --env-file if you override defaults).

NODE_ENV=development
PORT=3010
DB_HOST=localhost
DB_USER=adg-user-postgres
DB_PASSWORD=postgres
DB_NAME=adg-db-postgres
DB_PORT=15433
PASSWORD_VALIDATORS=minLength,uppercase,number,specialChar
PASSWORD_MIN_LENGTH=8
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:4730
PLATFORM_ONBOARDING_KEY=local-onboarding-key
